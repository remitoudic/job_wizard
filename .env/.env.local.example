# Example Local Development Environment Configuration
# Copy this file to .env for local development on your laptop

# Database Configuration (Local)
POSTGRES_USER=jobwizard
POSTGRES_PASSWORD=changeme123
POSTGRES_DB=jobwizard
DATABASE_URL=postgresql://jobwizard:changeme123@postgres:5432/jobwizard

# Ollama Configuration (Local)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# OpenRouter Configuration (Optional - for remote LLM)
# Get your key from: https://openrouter.ai/
OPENROUTER_API_KEY=

# NVIDIA NIM Configuration (Optional)
# Get your key from: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL_1=poolside/laguna-xs-2.1
NVIDIA_MODEL_2=meta/llama-3.1-8b-instruct
NVIDIA_MODEL_3=google/gemma-2-2b-it

# Logfire Configuration (Optional - for observability)
# Get your token from: https://logfire.pydantic.dev/
LOGFIRE_TOKEN=

# Backend Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend Configuration (IMPORTANT: Use localhost for local dev)
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# CORS (IMPORTANT: Use localhost for local dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# LlamaCloud Configuration (CV Parsing)
# Get your key from: https://cloud.llamaindex.ai/
LLAMA_CLOUD_API_KEY=

# Cloudinary Configuration (Profile Picture Storage)
# Get your URL from Cloudinary Dashboard: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

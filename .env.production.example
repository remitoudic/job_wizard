# Production Environment Configuration
# Copy this file to .env.production and update the values for your production server

# IMPORTANT: Change these values for production!

# Database Configuration (Production)
POSTGRES_USER=jobwizard
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
POSTGRES_DB=jobwizard
DATABASE_URL=postgresql://jobwizard:CHANGE_THIS_TO_A_STRONG_PASSWORD@postgres:5432/jobwizard

# Ollama Configuration (Production)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# OpenRouter Configuration (Optional - for remote LLM)
# Get your key from: https://openrouter.ai/
OPENROUTER_API_KEY=

# Logfire Configuration (Optional - for observability)
# Get your token from: https://logfire.pydantic.dev/
LOGFIRE_TOKEN=

# Backend Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend Configuration (IMPORTANT: Update with your server IP or domain)
# If using IP address: ORIGIN=http://123.45.67.89
# If using domain: ORIGIN=https://yourdomain.com
ORIGIN=http://YOUR_SERVER_IP

# API URL - Should point to your server IP or domain
# If using IP address: VITE_API_URL=http://123.45.67.89/api
# If using domain with SSL: VITE_API_URL=https://yourdomain.com/api
VITE_API_URL=http://YOUR_SERVER_IP/api

# CORS - Allow requests from your domain/IP
# If using IP: CORS_ORIGINS=http://123.45.67.89
# If using domain with SSL: CORS_ORIGINS=https://yourdomain.com
CORS_ORIGINS=http://YOUR_SERVER_IP
